local function makeLineTracerSpawner(newNumberSequenceKeypoint, RunService, insert, floor, custom_tracer_lifetime, worldToScreenRef, custom_tracer_outline, numberSequenceRef, sixthArgument, easeOutQuad, min, custom_tracer_fade, colorSequence, custom_tracer_width, max, custom_tracer_position_lerp, newNumberSequence)

    return function(cframe, secondArgument, color)
        local sixthArgumentResult, sixthArgumentResult2 = sixthArgument('Line'), sixthArgument('Line')
        local maximum = max(1, floor(custom_tracer_width.Value))

        sixthArgumentResult.Thickness, sixthArgumentResult2.Thickness = maximum + 2, maximum
        sixthArgumentResult.Color = Color3.new()

        local uIGradient = Instance.new('UIGradient', sixthArgumentResult2._frame)

        uIGradient.Color = color
        uIGradient.Rotation = 0

        local uIGradient2 = Instance.new('UIGradient', sixthArgumentResult._frame)

        uIGradient2.Color = colorSequence
        uIGradient2.Rotation = 0
        uIGradient2.Transparency, uIGradient.Transparency = numberSequenceRef.value, numberSequenceRef.value
        sixthArgumentResult2.Color = Color3.new(1, 1, 1)
        sixthArgumentResult2.ZIndex = 2

        local connection, number = nil, 0
        local custom_tracer_lifetimeValue, custom_tracer_fadeValue = custom_tracer_lifetime.Value, custom_tracer_fade.Value
        local custom_tracer_position_lerpValue = custom_tracer_position_lerp.Value
        local custom_tracer_outlineValue = custom_tracer_outline.Value
        local secondArgument2 = secondArgument

        connection = RunService.RenderStepped:Connect(function(deltaTime)
            number = number + deltaTime

            if number > custom_tracer_lifetimeValue + custom_tracer_fadeValue then
                sixthArgumentResult:Remove()
                sixthArgumentResult2:Remove()

                return connection:Disconnect()
            end
            if custom_tracer_position_lerpValue ~= 0 then
                local eased = easeOutQuad(min(number / custom_tracer_position_lerpValue, 1))

                secondArgument2 = cframe:Lerp(secondArgument, eased)
            end

            local screenPosition, onScreen = worldToScreenRef.value(cframe)

            if not onScreen then
                sixthArgumentResult.Visible, sixthArgumentResult2.Visible = false, false

                return
            end

            local screenPosition2, onScreen2 = worldToScreenRef.value(secondArgument2)

            if not onScreen2 then
                sixthArgumentResult.Visible, sixthArgumentResult2.Visible = false, false

                return
            end
            if number > custom_tracer_lifetimeValue then
                local ratio = (number - custom_tracer_lifetimeValue) / custom_tracer_fadeValue
                local transparency2 = {}

                for index = 0, 9 do

                    local index2 = index / 9

                    insert(transparency2, newNumberSequenceKeypoint(index2, ratio + (1 - index2) / 2))
                end

                transparency2 = newNumberSequence(transparency2)
                uIGradient.Transparency = transparency2

                if custom_tracer_outlineValue then
                    uIGradient2.Transparency = transparency2
                end
            end
            if custom_tracer_outlineValue then
                local unit = (screenPosition2 - screenPosition).Unit

                sixthArgumentResult.To, sixthArgumentResult.From = screenPosition2 + unit, screenPosition - unit
                sixthArgumentResult.Visible = true
            else
                sixthArgumentResult.Visible = false
            end

            sixthArgumentResult2.To, sixthArgumentResult2.From = screenPosition2, screenPosition
            sixthArgumentResult2.Visible = true
        end)
    end
end

