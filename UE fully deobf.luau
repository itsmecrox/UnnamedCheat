local function setupKeyPicker(option, userInputServiceService, frame, label, label2, createLabel, key, createLabel2, name, frame2, lookup)

    return function()
        local modes = label.Modes or {
            'Always',
            'Toggle',
            'Hold',
        }
        local addContextMenu = label2:AddContextMenu(frame)
        local list = {}

        for _, mode in modes do

            local label

            label = addContextMenu:AddOption(mode, function()
                option.Mode = mode
                label.TextColor3 = label2.AccentColor

                for key, item in list do

                    if item ~= label then
                        item.TextColor3 = key == option.Mode and label2.AccentColor or label2.FontColor
                    end
                end

                label2:AttemptSave()
            end)

            label:GetPropertyChangedSignal('TextColor3'):Connect(function()
                if mode == option.Mode then
                    label.TextColor3 = label2.AccentColor
                else
                    label.TextColor3 = label2.FontColor
                end
            end)

            list[mode] = label
        end

        if label2.FlagCopying then
            addContextMenu:AddOption('Copy Flag', function()
                pcall(setclipboard, option.Idx)
                task.wait()
                label2:Notify('Copied flag to clipboard!', 2)
                addContextMenu:Hide()
            end)
        end

        for key, item in list do

            item.TextColor3 = key == option.Mode and label2.AccentColor or label2.FontColor
        end

        local updateKeybindLabel = function(state)
            local mode = option.Mode

            mode = mode ~= 'Always' and option.Override and 'Override' or mode
            createLabel.Text = string.format('[%s] %s (%s)', option.Value, label.Text, mode)
            createLabel.Visible = true
            createLabel.TextColor3 = state and label2.AccentColor or label2.FontColor
            label2.RegistryMap[createLabel].Properties.TextColor3 = state and 'AccentColor' or 'FontColor'
        end

        function option:Update()
            if not option.NoUI then
                local keypickerListMode = label2.KeypickerListMode
                local state = option:GetState()

                if keypickerListMode == 'Active' and option.Parent.Type == 'Toggle' and (not state or not option.Parent.Value) then
                    createLabel.Visible = false
                elseif keypickerListMode == 'Toggled' and option.Parent.Type == 'Toggle' and not option.Parent.Value then
                    createLabel.Visible = false
                else
                    updateKeybindLabel(state)
                end
            else
                createLabel.Visible = false
            end

            local number = 0
            local number2 = 0

            for _, keybindContainerChildrenItem in next, label2.KeybindContainer:GetChildren()do

                if keybindContainerChildrenItem:IsA('TextLabel') and keybindContainerChildrenItem.Visible then
                    number = number + 18

                    if keybindContainerChildrenItem.TextBounds.X > number2 then
                        number2 = keybindContainerChildrenItem.TextBounds.X
                    end
                end
            end

            label2.KeybindFrame.Size = UDim2.new(0, math.max(number2 + 10, 210), 0, number + 23)
            label2.KeybindFrame.Visible = label2.KeypickerListVisible and number ~= 0
        end
        function option:OverrideState(overrideState)
            if self.Override == overrideState then
                return
            end

            self.Override = overrideState
            option.Toggled = false

            option:Update()
        end

        local isMouseButtonPressed, isKeyDown = userInputServiceService.IsMouseButtonPressed, userInputServiceService.IsKeyDown
        local mouseButton, mouseButton2 = Enum.UserInputType.MouseButton1, Enum.UserInputType.MouseButton2
        local keyCode = Enum.KeyCode

        function option:GetState()
            local mode = option.Mode

            if mode == 'Always' then
                return true
            end

            local optionValue = option.Value

            if optionValue == '...' then
                return true
            end

            local matches = nil

            if mode == 'Hold' then
                if optionValue == 'MB1' or optionValue == 'MB2' then
                    matches = optionValue == 'MB1' and isMouseButtonPressed(userInputServiceService, mouseButton) or optionValue == 'MB2' and isMouseButtonPressed(userInputServiceService, mouseButton2)
                else
                    matches = isKeyDown(userInputServiceService, keyCode[optionValue])
                end
            else
                matches = option.Toggled
            end
            if matches and self.Override then
                option:OverrideState(false)
            end

            return matches or self.Override
        end
        function option:SetValue(newValue)
            local newValueItem, newValueItem2 = newValue[1], newValue[2]

            createLabel2.Text = newValueItem
            option.Value, option.Mode = newValueItem, newValueItem2

            for key, item in list do

                item.TextColor3 = key == option.Mode and label2.AccentColor or label2.FontColor
            end

            option:Update()
        end
        function option:OnClick(callback)
            option.Clicked = callback
        end
        function option:OnChanged(callback)
            option.Changed = callback

            callback(option.Value)
        end

        if name.Addons then
            table.insert(name.Addons, option)
        end

        function option:DoClick()
            if option.Override then
                option.Override = false
                option.Toggled = false
            end
            if name.Type == 'Toggle' and option.SyncToggleState then
                name:SetValue(not name.Value)
            end

            label2:SafeCallback(option.Callback, option.Toggled)
            label2:SafeCallback(option.Clicked, option.Toggled)
        end
        function option:SetupConnection(connection)
            table.insert(self.Connections, connection)
            label2:GiveSignal(connection)
        end
        function option:Remove()
            lookup[key] = nil

            for _, connection in option.Connections do
                connection:Disconnect()
            end

            table.clear(option)
            frame:Destroy()
            createLabel:Destroy()
        end
        function option:SetModePickerVisibility(visible)
            frame2.Visible = visible
        end
        function option:GetModePickerVisibility()
            return frame2.Visible
        end

        local flag = false
        local lookup2 = {
            [Enum.KeyCode.Escape] = true,
            [Enum.KeyCode.Backspace] = true,
        }

        frame.InputBegan:Connect(function(input)
            if not flag and input.UserInputType == Enum.UserInputType.MouseButton1 and not label2:MouseIsOverOpenedFrame() then
                flag = true
                createLabel2.Text = ''

                local flag2
                local text = ''

                task.spawn(function()
                    while not flag2 do

                        if text == '...' then
                            text = ''
                        end

                        text = text .. '.'
                        createLabel2.Text = text

                        wait(0.4)
                    end
                end)
                wait(0.2)

                local connection

                connection = userInputServiceService.InputBegan:Connect(function(input)
                    local text

                    if input.UserInputType == Enum.UserInputType.Keyboard then
                        text = lookup2[input.KeyCode] and '...' or input.KeyCode.Name
                    elseif input.UserInputType == Enum.UserInputType.MouseButton1 then
                        text = 'MB1'
                    elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
                        text = 'MB2'
                    end

                    flag2 = true
                    flag = false
                    createLabel2.Text = text
                    option.Value = text

                    label2:SafeCallback(option.ChangedCallback, input.KeyCode or input.UserInputType)
                    label2:SafeCallback(option.Changed, input.KeyCode or input.UserInputType)
                    label2:AttemptSave()
                    connection:Disconnect()
                end)
            end
        end)
        option:SetupConnection(userInputServiceService.InputBegan:Connect(function(input, gameProcessed)
            if not flag and not gameProcessed then
                if option.Mode == 'Toggle' then
                    local optionValue = option.Value

                    if optionValue == 'MB1' or optionValue == 'MB2' then
                        if optionValue == 'MB1' and input.UserInputType == Enum.UserInputType.MouseButton1 or optionValue == 'MB2' and input.UserInputType == Enum.UserInputType.MouseButton2 then
                            option.Toggled = not option.Toggled

                            option:DoClick()
                        end
                    elseif input.UserInputType == Enum.UserInputType.Keyboard then
                        if input.KeyCode.Name == optionValue then
                            option.Toggled = not option.Toggled

                            option:DoClick()
                        end
                    end
                end

                option:Update()
            end
        end))
        option:SetupConnection(userInputServiceService.InputEnded:Connect(function(input)
            if not flag then
                option:Update()
            end
        end))
        option:Update()

        lookup[key] = option
    end
end

