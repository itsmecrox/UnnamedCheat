local function makeFacingCheck(rawValue, dot, angles, key)

    return function(vector)
        local rawValueItem = rawValue[key]

        return dot((angles(0, rawValueItem.Y, 0) * angles(rawValueItem.X, 0, 0)).LookVector, vector.Unit) > 0.5
    end
end

local function makeFakePositionCheck()
    return function()
        local protection_fake_positionFn, protection_fake_position_keybindFn = Toggles.protection_fake_position, Options.protection_fake_position_keybind

        do
            return function()
                return protection_fake_positionFn.Value and protection_fake_position_keybindFn:GetState()
            end
        end
    end
end

local function makePlayerDropdownUpdater(list, newValueRef)

    return function()
        local valueResult = newValueRef.value()

        for _, item in next, list do

            if item.Type == 'Dropdown' and item.SpecialType == 'Player' then
                item:SetValues(valueResult)
            end
        end
    end
end

local function makeBoundsCalculator(firstArgument, huge2, newValueRef, settings, worldToScreenRef)

    return function(firstArgument2, list)
        local huge3 = huge2
        local value, screenPosition

        for key, item in list do

            if settings[key] or newValueRef.value[key] then
                continue
            elseif firstArgument(item) ~= 'Instance' or item.ClassName ~= 'MeshPart' then
                continue
            end

            local screenPosition2 = worldToScreenRef.value(item.Position)
            local magnitude = (screenPosition2 - firstArgument2).Magnitude

            if magnitude < huge3 then
                huge3, value = magnitude, item
                screenPosition = screenPosition2
            end
        end

        return value, screenPosition
    end
end

local function makeAtmosphereUpdater(atmosphere)

    return function()
        atmosphere.Parent = Toggles.atmosphere_enabled.Value and game:GetService('Lighting') or nil

        if not atmosphere.Parent then
            return
        end

