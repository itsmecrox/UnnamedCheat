local function makeTracerSpawner(newTweenInfo, custom_tracer_length, custom_tracer_speed, terrain, custom_tracer_position_lerp, beam, custom_tracer_fade, custom_tracer_lifetime, custom_tracer_width, custom_tracer_glow, custom_tracer_emission, newInstance, tweenServiceService)

    return function(firstArgument, worldPosition, color)
        local instance, instance2 = newInstance('Attachment', terrain), newInstance('Attachment', terrain)

        instance.WorldPosition, instance2.WorldPosition = firstArgument, firstArgument

        local beamClone = beam:Clone()
        local custom_tracer_widthValue = custom_tracer_width.Value

        beamClone.Width0, beamClone.Width1 = custom_tracer_widthValue, custom_tracer_widthValue
        beamClone.LightEmission = custom_tracer_emission.Value
        beamClone.TextureSpeed = custom_tracer_speed.Value
        beamClone.TextureLength = custom_tracer_length.Value
        beamClone.Parent = instance
        beamClone.Color = color
        beamClone.Attachment0 = instance
        beamClone.Attachment1 = instance2

        local beamCloneClones = {beamClone}

        for index = 1, custom_tracer_glow.Value - 1 do

            local beamCloneClone = beamClone:Clone()

            beamCloneClone.Parent = beamClone.Parent

            table.insert(beamCloneClones, beamCloneClone)
        end

        tweenServiceService:Create(instance2, newTweenInfo(custom_tracer_position_lerp.Value), {WorldPosition = worldPosition}):Play()
        task.delay(custom_tracer_lifetime.Value, function()
            local animation

            for _, beamCloneClone in beamCloneClones do

                animation = tweenServiceService:Create(beamCloneClone, newTweenInfo(custom_tracer_fade.Value), {
                    Width0 = 0,
                    Width1 = 0,
                })

                animation:Play()
            end

            animation.Completed:Wait()
            instance:Destroy()
            instance2:Destroy()
        end)
    end
end

