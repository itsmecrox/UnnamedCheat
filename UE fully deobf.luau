local function setupConfiguration(configManager, options, toggles)

    return function()

        local httpService = (cloneref or function(firstArgument)
            return firstArgument
        end)(game:GetService('HttpService'))
        local isfolderFn, isfileFn, listfilesFn = isfolder, isfile, listfiles

        do
            configManager.Folder = ''
            configManager.Ignore = {}
            configManager.Parser = {
                Toggle = {
                    Save = function(optionId, option)
                        return {
                            type = 'Toggle',
                            idx = optionId,
                            value = option.Value,
                        }
                    end,
                    Load = function(optionId, savedValue)
                        if toggles[optionId] then
                            toggles[optionId]:SetValue(savedValue.value)
                        end
                    end,
                },
                Slider = {
                    Save = function(optionId, option)
                        return {
                            type = 'Slider',
                            idx = optionId,
                            value = tostring(option.Value),
                        }
                    end,
                    Load = function(optionId, savedValue)
                        if options[optionId] then
                            options[optionId]:SetValue(savedValue.value)
                        end
                    end,
                },
                Dropdown = {
                    Save = function(optionId, option)
                        return {
                            type = 'Dropdown',
                            idx = optionId,
                            value = option.Value,
                            mutli = option.Multi,
                        }
                    end,
                    Load = function(optionId, savedValue)
                        if options[optionId] then
                            options[optionId]:SetValue(savedValue.value)
                        end
                    end,
                },
                ColorPicker = {
                    Save = function(optionId, option)
                        return {
                            type = 'ColorPicker',
                            idx = optionId,
                            value = option.Value:ToHex(),
                            transparency = option.Transparency,
                        }
                    end,
                    Load = function(optionId, savedValue)
                        if options[optionId] then
                            options[optionId]:SetValueRGB(Color3.fromHex(savedValue.value), savedValue.transparency)
                        end
                    end,
                },
                KeyPicker = {
                    Save = function(optionId, option)
                        return {
                            type = 'KeyPicker',
                            idx = optionId,
                            mode = option.Mode,
                            key = option.Value,
                        }
                    end,
                    Load = function(optionId, savedValue)
                        if options[optionId] then
                            options[optionId]:SetValue({
                                savedValue.key,
                                savedValue.mode,
                            })
                        end
                    end,
                },
                Input = {
                    Save = function(optionId, option)
                        return {
                            type = 'Input',
                            idx = optionId,
                            text = option.Value,
                        }
                    end,
                    Load = function(optionId, savedValue)
                        if options[optionId] and type(savedValue.text) == 'string' then
                            options[optionId]:SetValue(savedValue.text)
                        end
                    end,
                },
            }

            function configManager:BuildFolderTree()
                local folders = {
                    self.Folder,
                    self.Folder .. '/settings',
                    self.Folder .. '/themes',
                }

                for index = 1, #folders do

                    local folderPath = folders[index]

                    if not isfolderFn(folderPath) then
                        makefolder(folderPath)
                    end
                end
            end
            function configManager:CheckFolderTree()
                if not isfolderFn(self.Folder) then
                    configManager:BuildFolderTree()
                    task.wait()
                end
            end
            function configManager:SetIgnoreIndexes(indexes)
                for _, index in next, indexes do

                    self.Ignore[index] = true
                end
            end
            function configManager:SetFolder(folder)
                self.Folder = folder

                self:BuildFolderTree()
            end
            function configManager:Save(configName, overwrite)
                if not configName then
                    return false, 'no config file is selected'
                end

                configManager:CheckFolderTree()

                local configPath = self.Folder .. '/settings/' .. configName .. '.json'
                local savedConfig = {objects = {}}

                for key, toggle in next, toggles do

                    if self.Ignore[key] then
                        continue
                    end

                    table.insert(savedConfig.objects, self.Parser[toggle.Type].Save(key, toggle))
                end
                for key, option in next, options do

                    if not self.Parser[option.Type] then
                        continue
                    end
                    if self.Ignore[key] then
                        continue
                    end

                    table.insert(savedConfig.objects, self.Parser[option.Type].Save(key, option))
                end

                local success, resultOrError = pcall(httpService.JSONEncode, httpService, savedConfig)

                if not success then
                    return false, 'failed to encode data'
                end
                if not overwrite then
                    writefile(configPath, resultOrError)
                end

                return true, resultOrError
            end
            function configManager:Load(configOrName)
                if not configOrName then
                    return false, 'no config file is selected'
                end
                if type(configOrName) == 'table' then
                    for _, object in next, configOrName.objects do

                        if self.Parser[object.type] then
                            task.spawn(function()
                                self.Parser[object.type].Load(object.idx, object)
                            end)
                        end
                    end

                    return true
                end

                configManager:CheckFolderTree()

                local configPath = self.Folder .. '/settings/' .. configOrName .. '.json'

                if not isfileFn(configPath) then
                    return false, 'invalid file'
                end

                local success, resultOrError = pcall(httpService.JSONDecode, httpService, readfile(configPath))

                if not success then
                    return false, 'decode error'
                end

                for _, object in next, resultOrError.objects do

                    if self.Parser[object.type] then
                        task.spawn(function()
                            self.Parser[object.type].Load(object.idx, object)
                        end)
                    end
                end

                return true
            end
            function configManager:Delete(configName)
                if not configName then
                    return false, 'no config file is selected'
                end

                local configPath = self.Folder .. '/settings/' .. configName .. '.json'

                if not isfileFn(configPath) then
                    return false, 'invalid file'
                end

                local success, resultOrError = pcall(delfile, configPath)

                if not success then
                    return false, 'delete file error'
                end

                return true
            end
            function configManager:IgnoreThemeSettings()
                self:SetIgnoreIndexes({
                    'ThemeManager_ThemeList',
                    'ThemeManager_CustomThemeList',
                    'ThemeManager_CustomThemeName',
                    'VideoLink',
                    'Brightness',
                    'Contrast',
                    'Saturation',
                    'Brightness',
                    'BlurSize',
                    'FontColor',
                    'RiskColor',
                    'MainColor',
                    'AccentColor',
                    'BackgroundColor',
                    "OutlineColor",
                    'SwordColor',
                    'ItemType',
                    'BackTransparency',
                    'BackColor',
                    'SwordTransparency',
                    'SwordReflectance',
                    'SwordMaterial',
                    'SwordSpeed',
                })
            end
            function configManager:RefreshConfigList()
                local files = listfilesFn(self.Folder .. '/settings')
                local list = {}

                for index = 1, #files do

                    local file = files[index]

                    if file:sub(-5) == '.json' then
                        local matchStart = file:find('.json', 1, true)
                        local matchStart2 = matchStart
                        local text = file:sub(matchStart, matchStart)

                        while text ~= '/' and text ~= '\\' and text ~= '' do

                            matchStart = matchStart - 1
                            text = file:sub(matchStart, matchStart)
                        end

                        if text == '/' or text == '\\' then
                            table.insert(list, file:sub(matchStart + 1, matchStart2 - 1))
                        end
                    end
                end

                return list
            end
            function configManager:SetLibrary(library)
                self.Library = library
            end
            function configManager:LoadAutoloadConfig()
                configManager:CheckFolderTree()

                if isfileFn(self.Folder .. '/settings/autoload.txt') then
                    local fileContents = readfile(self.Folder .. '/settings/autoload.txt')
                    local load, text = self:Load(fileContents)

                    if not load then
                        return self.Library:Notify('Failed to load autoload config: ' .. text)
                    end
                    if not SILENT then
                        self.Library:Notify(string.format('Auto loaded config %q', fileContents))
                    end
                end
            end
        end

        getgenv().SaveManager = configManager
    end
end

local function setupContainerSize(frame, frame2, box, fourthArgument, fifthArgument)

    return function()
        function fourthArgument:SetSize(size)
            frame2.Size = UDim2.new(1, -4, 0, size)

            fifthArgument:Resize()
        end
        function fourthArgument:GetOuter()
            return frame2
        end
        function fourthArgument:GetInner()
            return frame
        end
        function fourthArgument:GetSize()
            return frame.AbsoluteSize
        end

        table.insert({}, box:AddBlank(5))
        box:Resize()
    end
end

local function setupDependencies(label, settings, metatable, frame, fifthArgument, frame2, uIListLayout)

    return function()
        function settings:Resize()
            frame.Size = UDim2.new(1, 0, 0, uIListLayout.AbsoluteContentSize.Y)

            fifthArgument:Resize()
        end

        uIListLayout:GetPropertyChangedSignal('AbsoluteContentSize'):Connect(function()
            settings:Resize()
        end)
        frame:GetPropertyChangedSignal('Visible'):Connect(function()
