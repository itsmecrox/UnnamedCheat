local arguments = table.pack(...)

if type(arguments[2]) ~= 'function' then
    arguments[2] = function() end
    if arguments.n < 2 then arguments.n = 2 end
end
local sharedEnv = getgenv and getgenv() or _G
local previous = rawget(sharedEnv, 'Unnamed Enhancements - Open Source')

if type(previous) == 'table' and (previous.status == 'starting' or previous.status == 'entry_returned') then
    return previous
end
if rawget(sharedEnv, 'UE_LOADED') == true then
    local oldGui = rawget(sharedEnv, 'Library')
    if type(oldGui) == 'table' and typeof(oldGui.ScreenGui) == 'Instance' and oldGui.ScreenGui.Parent ~= nil then
        warn('[Unnamed Enhancements] already loaded - unload it from the UI first, or rejoin.')
        return previous
    end

    sharedEnv.UE_LOADED = nil
end

local function report(message)
    local text = '[Unnamed Enhancements] ' .. tostring(message)
    if type(warn) == 'function' then warn(text) else print(text) end
end

local getIdentity = getthreadidentity or getidentity or get_thread_identity or (syn and syn.get_thread_identity)
local setIdentity = setthreadidentity or setidentity or set_thread_identity or (syn and syn.set_thread_identity)
local function keepIdentity(rawRequire, ...)
    local before
    if getIdentity then
        local ok, level = pcall(getIdentity)
        if ok and type(level) == 'number' then before = level end
    end
    local results = table.pack(pcall(rawRequire, ...))
    if setIdentity then pcall(setIdentity, before or 8) end
    if not results[1] then error(results[2], 0) end
    return table.unpack(results, 2, results.n)
end
local rawRequire = require
local function require(...)
    return keepIdentity(rawRequire, ...)
end

local control = {
    status = 'starting',
    started = os.clock(),
    error = nil,
    stopped = false,
}

local previousLoaded = rawget(sharedEnv, 'UE_LOADED')
local previousLibrary = rawget(sharedEnv, 'Library')
local previousOptions = rawget(sharedEnv, 'Options')
local previousToggles = rawget(sharedEnv, 'Toggles')

local function failIntegrity()
    error("script integrity check failed", 0)
end
local function Reference(read, write)
    return setmetatable({}, {
        __index = function()
            return read()
        end,
        __newindex = function(_, _, newValue)
            write(newValue)
        end,
    })
end

local function queueOnTeleport(...)
    local queue = queue_on_teleport
    or (syn and syn.queue_on_teleport)
    or (fluxus and fluxus.queue_on_teleport)
    or (rawget(getgenv(), 'queue_on_teleport'))

    if type(queue) == 'function' then
        return queue(...)
    end
end
local function buildAutoloadCode()
    local env = getgenv()
    local url = rawget(env, 'UE_AUTOLOAD_URL')
    local file = rawget(env, 'UE_AUTOLOAD_FILE')

    if type(file) ~= 'string' or file == '' then
        file = 'UnnamedEnhancements.lua'
    end

    local load
    if type(url) == 'string' and url ~= '' then
        load = string.format('loadstring(game:HttpGet(%q))()', url)
    else
        load = string.format('local path = %q\nif isfile and isfile(path) then loadstring(readfile(path), "=UnnamedEnhancements")() end', file)
    end

    return (('if not game:IsLoaded() then game.Loaded:Wait() end\n' .. load):gsub('%%', '%%%%'))
end
local autoloadCode = buildAutoloadCode()

local function setupButtons(createButtonInput, label, box, createButtonFrame, label2)

    return function()
        function label:AddButton(...)
            local matches = typeof(select(1, ...)) == 'table' and select(1, ...) or {
                Text = select(1, ...),
                Func = select(2, ...),
            }

            assert(typeof(matches.Func) == 'function', 'AddButton: `Func` callback is missing.')

            self.Outer.Size = UDim2.new(0.5, -2, 0, 20)
            matches.Outer, matches.Inner, matches.Label = createButtonFrame(matches)
            matches.Outer.Position = UDim2.new(1, 3, 0, 0)
            matches.Outer.Size = UDim2.new(1, -3, 1, 0)
            matches.Outer.Parent = self.Outer

            function matches:AddTooltip(tooltip2)
                if typeof(tooltip2) == 'string' then
                    label2:AddToolTip(tooltip2, self.Outer)
                end

                return matches
            end

            if typeof(matches.Tooltip) == 'string' then
                matches:AddTooltip(matches.Tooltip)
            end

            createButtonInput(matches)

            return matches
        end

        local boxes = {}

        function label:Remove()
            for _, box in boxes do
                box:Destroy()
            end

            label.Outer:Destroy()
            table.clear(label)
            box:Resize()
        end

        if typeof(label.Tooltip) == 'string' then
            label:AddTooltip(label.Tooltip)
        end

        table.insert(boxes, box:AddBlank(5))
        box:Resize()
    end
end

local function setupColorPicker(colorPicker, renderStepped, label, fourthArgument, mouse, create, textBox, lookup, imageLabel, imageButton, frame, imageLabel2, frame2, parentRef, create2, frame3, userInputService, name, key, frame4, frame5, frame6, frameRef, create3)

    return function()
        local addContextMenu = label:AddContextMenu(create2)

        addContextMenu:AddOption('Make gradient', function()
            local addons = {}

            for _, addon in name.Addons do

                if addon.Type == 'ColorPicker' then
                    table.insert(addons, addon)
                end
            end

            if #addons < 3 then
                addContextMenu:Hide()

                return label:Notify('not enough colors for a gradient.', 2)
            end

            local addonValue, addonValue2 = addons[1].Value, addons[#addons].Value

            for index = 2, #addons - 1 do

                local addon = addons[index]

                addon:SetValueRGB(addonValue:Lerp(addonValue2, index / #addons), addon.Transparency)
            end

            label:Notify('created gradient!', 2)
            addContextMenu:Hide()
        end)
        addContextMenu:AddOption('Match color', function()
            local addons = {}

            for _, addon in name.Addons do

