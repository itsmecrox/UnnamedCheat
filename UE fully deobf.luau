local function makeMenuVisibilityHandler(contextActionService, renderStepped, label, blurEffect, newValueRef, textButton, userInputService, screenGui, objects, frame, colorCorrectionEffect, list)

    return function()

        local enabled = false

        function label:Toggle()

            enabled = not enabled
            label.Toggled = enabled
            newValueRef.value = enabled

            label:FireEvent('VisibilityChanged', newValueRef.value)

            textButton.Modal = enabled

            if enabled then
                frame.Visible = true

                local guiService = game:GetService('GuiService')

                task.spawn(function()
                    local mouseIconEnabled = userInputService.MouseIconEnabled
                    local imageLabel = Instance.new('ImageLabel', screenGui)

                    imageLabel.Image = 'http://www.roblox.com/asset/?id=4292970642'
                    imageLabel.BackgroundTransparency = 1
                    imageLabel.ZIndex = 125

                    local imageLabel2 = Instance.new('ImageLabel', screenGui)

                    imageLabel2.Image = 'http://www.roblox.com/asset/?id=4292970642'
                    imageLabel2.ImageColor3 = Color3.new()
                    imageLabel2.BackgroundTransparency = 1
                    imageLabel2.ZIndex = 124
                    imageLabel.Size, imageLabel2.Size = UDim2.fromOffset(17, 17), UDim2.fromOffset(19, 19)
                    imageLabel.Rotation, imageLabel2.Rotation = -45, -45

                    while enabled and screenGui.Parent do

                        userInputService.MouseIconEnabled = false

                        local mousePosition = userInputService:GetMouseLocation()
                        local size = UDim2.fromOffset(mousePosition.X, mousePosition.Y - guiService:GetGuiInset().Y - 1)

                        imageLabel.ImageColor3 = label.AccentColor
                        imageLabel.Position, imageLabel2.Position = size, size - UDim2.fromOffset(1, 1)

                        renderStepped:Wait()
                    end

                    userInputService.MouseIconEnabled = mouseIconEnabled

                    imageLabel:Destroy()
                    imageLabel2:Destroy()
                end)
            end

            for _, item in list do
                task.spawn(function()
                    if item.Type == 'Dropdown' then
                        item:CloseDropdown()
                    elseif item.Type == 'KeyPicker' then
                        item:SetModePickerVisibility(false)
                    elseif item.Type == 'ColorPicker' then
                        item:Hide()
                    end
                end)
            end

            if enabled and label.BlockInput then
                contextActionService:BindAction('Freeze', function()
                    return Enum.ContextActionResult.Sink
                end, false, table.unpack(Enum.PlayerActions:GetEnumItems()))
            else
                contextActionService:UnbindAction('Freeze')
            end

            blurEffect.Enabled = enabled
            colorCorrectionEffect.Enabled = enabled
            objects.Enabled = enabled
            frame.Visible = enabled
        end

        label:GiveSignal(userInputService.InputBegan:Connect(function(input, gameProcessed)
            if typeof(label.ToggleKeybind) == 'table' and label.ToggleKeybind.Type == 'KeyPicker' then
                if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode.Name == label.ToggleKeybind.Value then
                    task.spawn(label.Toggle)
                end
            elseif input.KeyCode == Enum.KeyCode.RightControl or input.KeyCode == Enum.KeyCode.Insert and not gameProcessed then
                task.spawn(label.Toggle)
            end
        end))
    end
end

