                    local matches = input.UserInputType == Enum.UserInputType.MouseButton1 and mouse.X or input.Position.X
                    local matches2 = input.UserInputType == Enum.UserInputType.MouseButton1 and mouse.Y or input.Position.Y
                    local absolutePosition, sum = imageLabel2.AbsolutePosition.X, imageLabel2.AbsolutePosition.X + imageLabel2.AbsoluteSize.X
                    local absolutePosition2, sum2 = imageLabel2.AbsolutePosition.Y, imageLabel2.AbsolutePosition.Y + imageLabel2.AbsoluteSize.Y
                    local clamped = math.clamp(matches, absolutePosition, sum)
                    local clamped2 = math.clamp(matches2, absolutePosition2, sum2)

                    colorPicker.Sat = (clamped - absolutePosition) / (sum - absolutePosition)
                    colorPicker.Vib = 1 - (clamped2 - absolutePosition2) / (sum2 - absolutePosition2)

                    colorPicker:Display()
                    renderStepped:Wait()
                end

                if connection then
                    connection:Disconnect()
                end

                label:AttemptSave()
            end
        end)
        frame.InputBegan:Connect(function(input)
            if label.IsDragging then
                return
            end
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
