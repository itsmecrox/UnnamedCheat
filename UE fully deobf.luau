        })

        textBox.FocusLost:Connect(function(enterPressed)
            if enterPressed then
                local success, resultOrError = pcall(Color3.fromHex, textBox.Text)

                if success and typeof(resultOrError) == 'Color3' then
                    colorPicker.Hue, colorPicker.Sat, colorPicker.Vib = Color3.toHSV(resultOrError)
                end
            end

            colorPicker:Display()
        end)
        create.FocusLost:Connect(function(enterPressed)
            if enterPressed then
                local match, green, blue = create.Text:match('(%d+),%s*(%d+),%s*(%d+)')

                if match and green and blue then
                    colorPicker.Hue, colorPicker.Sat, colorPicker.Vib = Color3.toHSV(Color3.fromRGB(match, green, blue))
                end
            end

            colorPicker:Display()
        end)

        function colorPicker:Display()
            colorPicker.Value = Color3.fromHSV(colorPicker.Hue, colorPicker.Sat, colorPicker.Vib)
            imageLabel2.BackgroundColor3 = Color3.fromHSV(colorPicker.Hue, 1, 1)

            label:Create(create2, {
                BackgroundColor3 = colorPicker.Value,
                BackgroundTransparency = colorPicker.Transparency,
