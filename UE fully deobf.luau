            function themeManager:ApplyTheme(themeName)
                if not themeName then
                    return
                end

                local customTheme = self:GetCustomTheme(themeName)
                local customTheme2 = customTheme or self.BuiltInThemes[themeName]

                if not customTheme2 then
                    return
                end
                if self.Library.InnerVideoBackground ~= nil then
                    self.Library.InnerVideoBackground.Visible = false
                end

                local customThemeItem = customTheme2[2]

                for key, customThemeItem2 in next, customTheme or customThemeItem do

                    if key:find('Color') then
                        self.Library[key] = Color3.fromHex(customThemeItem2)

                        if lookup[key] then
                            lookup[key]:SetValueRGB(Color3.fromHex(customThemeItem2))
                        end
                    else
                        self.Library[key] = customThemeItem2

                        if lookup[key] then
                            lookup[key]:SetValue(customThemeItem2)
                        end
                    end
                end

                self:ThemeUpdate()
            end
            function themeManager:ThemeUpdate()
                if self.Library.InnerVideoBackground ~= nil then
                    self.Library.InnerVideoBackground.Visible = false
                end

                local list = {
                    'Contrast',
                    'Saturation',
                    'Brightness',
                    'BlurSize',
                    'FontColor',
                    'RiskColor',
                    'MainColor',
                    'AccentColor',
                    'BackgroundColor',
                    "OutlineColor",
                    'SwordColor',
                    'ItemType',
                    'BackTransparency',
                    'BackColor',
                    'SwordTransparency',
                    'SwordReflectance',
                    'SwordMaterial',
                    'SwordSpeed',
                }

                for _, item in next, list do

                    if lookup and lookup[item] then
                        self.Library[item] = lookup[item].Value
                    end
                end

                self.Library.AccentColorDark = self.Library:GetDarkerColor(self.Library.AccentColor)

                self.Library:UpdateColorsUsingRegistry()
            end
            function themeManager:LoadDefault()
                local default = 'Default'
                local fileExists = isfile(self.Folder .. '/themes/default.txt') and readfile(self.Folder .. '/themes/default.txt')
                local flag = true

                if fileExists then
                    if self.BuiltInThemes[fileExists] then
                        default = fileExists
                    elseif self:GetCustomTheme(fileExists) then
                        default = fileExists
                        flag = false
                    end
                elseif self.BuiltInThemes[self.DefaultTheme] then
                    default = self.DefaultTheme
                end
                if flag then
                    lookup.ThemeManager_ThemeList:SetValue(default)
                else
                    self:ApplyTheme(default)
                end
            end
            function themeManager:SaveDefault(themeName)
                writefile(self.Folder .. '/themes/default.txt', themeName)
            end
            function themeManager:Delete(fileName)
                if not fileName then
                    return false, 'no config file is selected'
                end

                local text = self.Folder .. '/themes/' .. fileName

                if not isfile(text) then
                    return false, 'invalid file'
                end

                local success, resultOrError = pcall(delfile, text)

                if not success then
                    return false, 'delete file error'
                end

                return true
            end
            function themeManager:GetCustomTheme(fileName)
                if not fileName then
                    return
                end

                local text = self.Folder .. '/themes/' .. fileName

                if not isfile(text) then
                    return nil
                end

                local fileContents = readfile(text)
                local success, resultOrError = pcall(httpService.JSONDecode, httpService, fileContents)

                if not success then
                    return nil
                end

                return resultOrError
            end
            function themeManager:SaveCustomTheme(fileName)
                if not fileName or fileName:gsub(' ', '') == '' then
                    return self.Library:Notify('Invalid file name for theme (empty)', 3)
                end

                local value = {}
                local list = {
                    'Contrast',
                    'Saturation',
                    'Brightness',
                    'BlurSize',
                    'FontColor',
                    'RiskColor',
                    'MainColor',
                    'AccentColor',
                    'BackgroundColor',
                    "OutlineColor",
                    'ItemType',
                    'SwordColor',
                    'BackTransparency',
                    'BackColor',
                    'SwordTransparency',
                    'SwordReflectance',
                    'SwordMaterial',
                    'SwordSpeed',
                }

                for _, item in next, list do

                    if lookup[item] then
                        if not item:find('Color') then
                            value[item] = lookup[item].Value
                        else
                            value[item] = lookup[item].Value:ToHex()
                        end
                    end
                end

                writefile(self.Folder .. '/themes/' .. fileName, httpService:JSONEncode(value))
            end
            function themeManager:ReloadCustomThemes()
                local files = listfiles(self.Folder .. '/themes')
                local list = {}

                for index = 1, #files do

                    local file = files[index]

                    if file:sub(-5) == '.json' then
                        local matchStart = file:find('.json', 1, true)
                        local text = file:sub(matchStart, matchStart)

                        while text ~= '/' and text ~= '\\' and text ~= '' do

                            matchStart = matchStart - 1
                            text = file:sub(matchStart, matchStart)
                        end

                        if text == '/' or text == '\\' then
                            table.insert(list, file:sub(matchStart + 1))
                        end
                    end
                end

                return list
            end
            function themeManager:SetLibrary(library)
                self.Library = library
            end
            function themeManager:BuildFolderTree()
                local list = {}
                local split = self.Folder:split('/')

                for index = 1, #split do

                    list[#list + 1] = table.concat(split, '/', 1, index)
                end

                table.insert(list, self.Folder .. '/themes')

                for index = 1, #list do

                    local item = list[index]

                    if not isfolder(item) then
                        makefolder(item)
                    end
                end
            end
            function themeManager:SetFolder(folder)
                self.Folder = folder

                self:BuildFolderTree()
            end
            function themeManager:CreateGroupBox(tab)
                assert(self.Library, 'Must set ThemeManager.Library first!')

                return tab:AddLeftTabbox()
            end
            function themeManager:ApplyToTab(tab)
                assert(self.Library, 'Must set ThemeManager.Library first!')

                local createGroupBox = self:CreateGroupBox(tab)

                self:CreateThemeManager(createGroupBox)
            end
            function themeManager:ApplyToGroupbox(groupbox)
                assert(self.Library, 'Must set ThemeManager.Library first!')
                self:CreateThemeManager(groupbox)
            end
        end

        getgenv().ThemeManager = themeManager
    end
end

local function setupToggle(instance, name, frame, label, frame2, key, frame3, names, createLabel, lookup, frame4, sixthArgument, container, metatable)

    return function()
        function instance:Display()
            frame.BackgroundColor3 = instance.Value and label.AccentColor or label.MainColor
            frame.BorderColor3 = instance.Value and label.AccentColorDark or label.OutlineColor
            label.RegistryMap[frame].Properties.BackgroundColor3 = instance.Value and 'AccentColor' or 'MainColor'
            label.RegistryMap[frame].Properties.BorderColor3 = instance.Value and 'AccentColorDark' or "OutlineColor"
        end

        instance.UpdateColors = instance.Display

        function instance:OnChanged(callback)
            table.insert(instance.ChangedFuncs, callback)
            callback(instance.Value)
        end
        function instance:SetValue(newValue)
            if instance.SettingValue then
                return
            end

            instance.SettingValue = true
            newValue = not not newValue
            instance.Value = newValue

            instance:Display()

            for _, addon in next, instance.Addons do

                if addon.Type == 'KeyPicker' and addon.SyncToggleState then
                    addon.Toggled = newValue

                    addon:Update()
                end
            end

            label:SafeCallback(instance.Callback, newValue)

            for _, changedFunc in instance.ChangedFuncs do
                label:SafeCallback(changedFunc, newValue)
            end

            label:UpdateDependencyBoxes()

            instance.SettingValue = false
        end
        function instance:SetVisible(visible)
            instance.Visible = visible
            frame2.Visible = instance.Visible

            if Blank then
                Blank.Visible = instance.Visible
            end

            name:Resize()
        end
        function instance:Remove()
            for _, name in names do
                name:Destroy()
            end

            lookup[key] = nil

            frame3:Destroy()
            table.clear(instance)
            name:Resize()
        end

        frame4.InputBegan:Connect(function(input)
            if label.IsDragging then
                return
            end
            if input.UserInputType == Enum.UserInputType.MouseButton1 and not label:MouseIsOverOpenedFrame() or input.UserInputType == Enum.UserInputType.Touch then
                instance:SetValue(not instance.Value)
                label:AttemptSave()
            end
        end)

        if label.FlagCopying then
            local addContextMenu = label:AddContextMenu(frame2, frame4)

            addContextMenu:AddOption('Copy Flag', function()
                pcall(setclipboard, instance.Idx)
                task.wait()
                label:Notify('Copied flag to clipboard!', 2)
                addContextMenu:Hide()
            end)
        end
        if instance.Risky then
            label:RemoveFromRegistry(createLabel)

            createLabel.TextColor3 = label.RiskColor

            label:AddToRegistry(createLabel, {
                TextColor3 = 'RiskColor',
            })
        end

        instance:Display()
        table.insert(names, name:AddBlank(sixthArgument.BlankSize or 7))
        name:Resize()

        instance.ColorPickerCount = 0
        instance.ToggleRegion = frame4
        instance.TextLabel = createLabel
        instance.Container = container

        setmetatable(instance, metatable)

        lookup[key] = instance

        label:UpdateDependencyBoxes()
    end
end

local function setupValueCallbacks(settings, textBox, thirdArgument, lookup, label, key, name, names, textService, frame, frame2)

    return function()
        function settings:SetValue(newValue)
            if thirdArgument.MaxLength and #newValue > thirdArgument.MaxLength then
                newValue = newValue:sub(1, thirdArgument.MaxLength)
            end
            if settings.Numeric then
                if not tonumber(newValue) and newValue:len() > 0 then
                    newValue = settings.Value
                end
            end

            settings.Value = newValue
            textBox.Text = newValue

            label:SafeCallback(settings.Callback, settings.Value)
            label:SafeCallback(settings.Changed, settings.Value)
        end
        function settings:Remove()
            for _, name in names do
                name:Destroy()
            end

            lookup[key] = nil

            frame:Destroy()
            table.clear(settings)
            name:Resize()
        end

        if settings.Finished then
            textBox.FocusLost:Connect(function(enterPressed)
                settings:SetValue(textBox.Text)
                label:AttemptSave()
            end)
        else
            textBox:GetPropertyChangedSignal('Text'):Connect(function()
                settings:SetValue(textBox.Text)
                label:AttemptSave()
            end)
        end

        local function onFocusLost()
            local offsetX = 2
            local absoluteSize = frame2.AbsoluteSize.X

            if not textBox:IsFocused() or textBox.TextBounds.X <= absoluteSize - 2 * offsetX then
                textBox.Position = UDim2.new(0, offsetX, 0, 0)
            else
                local cursorPosition = textBox.CursorPosition

                if cursorPosition ~= -1 then
                    local text = string.sub(textBox.Text, 1, cursorPosition - 1)
                    local textSize = textService:GetTextSize(text, textBox.TextSize, textBox.Font, Vector2.new(math.huge, math.huge)).X
                    local sum = textBox.Position.X.Offset + textSize

                    if sum < offsetX then
                        textBox.Position = UDim2.fromOffset(offsetX - textSize, 0)
                    elseif sum > absoluteSize - offsetX - 1 then
                        textBox.Position = UDim2.fromOffset(absoluteSize - textSize - offsetX - 1, 0)
                    end
                end
            end
        end

        task.spawn(onFocusLost)
        textBox:GetPropertyChangedSignal('Text'):Connect(onFocusLost)
        textBox:GetPropertyChangedSignal('CursorPosition'):Connect(onFocusLost)
        textBox.FocusLost:Connect(onFocusLost)
        textBox.Focused:Connect(onFocusLost)

        if label.FlagCopying then
            local addContextMenu = label:AddContextMenu(frame)

            addContextMenu:AddOption('Copy Flag', function()
                pcall(setclipboard, settings.Idx)
                task.wait()
                label:Notify('Copied flag to clipboard!', 2)
                addContextMenu:Hide()
            end)
        end

        label:AddToRegistry(textBox, {
            TextColor3 = 'FontColor',
        })

        function settings:OnChanged(callback)
            settings.Changed = callback

            callback(settings.Value)
        end

        table.insert(names, name:AddBlank(5))
        name:Resize()

        lookup[key] = settings
    end
end

