local function makeLineOfSightCheck(raycast, raycastParams, thirdArgument)

    return function(firstArgument, secondArgument)
        local raycastHit = raycast(thirdArgument, firstArgument, secondArgument - firstArgument, raycastParams)

        return not raycastHit, raycastHit
    end
end

local function makeClampBetween(min, clamp, max)

    return function(firstArgument, secondArgument, thirdArgument)
        local minimum, maximum = min(secondArgument, thirdArgument), max(secondArgument, thirdArgument)

        return clamp(firstArgument, minimum, maximum)
    end
end

local function setupSlider(library, slider, thirdArgument, parent, label, newValueRef, mouse, label2, frame, tweenServiceService, createLabel, lookup, parent2, key, lookup2, createLabels, userInputService, renderStepped)

    return function()
        function slider:UpdateColors()
            parent.BackgroundColor3 = label2.AccentColor
            parent.BorderColor3 = label2.AccentColorDark
        end
        function slider:Display()
            local suffix = label.Suffix or ''

            if label.Compact then
                createLabel.Text = label.Text .. ': ' .. slider.Value .. suffix
            elseif label.HideMax then
                createLabel.Text = string.format('%s', slider.Value .. suffix)
            else
                createLabel.Text = string.format('%s/%s', slider.Value .. suffix, slider.Max .. suffix)
            end

            local mapValue = label2:MapValue(slider.Value, slider.Min, slider.Max, 0, 1)

            if newValueRef.value then
                newValueRef.value:Cancel()
            end

            newValueRef.value = tweenServiceService:Create(parent, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                Size = UDim2.new(mapValue, 0, 1, 0),
            })

            newValueRef.value:Play()

            frame.Visible = not (mapValue == 1 or mapValue == 0)
        end
        function slider:OnChanged(callback)
            table.insert(slider.ChangedFuncs, callback)
            callback(slider.Value)
        end

        local function roundToIncrement(mapValue)
            if slider.Increment then
                local product = math.round(mapValue / slider.Increment) * slider.Increment

                return tonumber(string.format('%.10f', product))
            elseif slider.Rounding == 0 then
                return math.floor(mapValue)
            end

            return tonumber(string.format('%.' .. slider.Rounding .. 'f', mapValue))
        end

        function slider:GetValueFromXOffset(offsetX)
            return roundToIncrement(label2:MapValue(offsetX, 0, slider.MaxSize, slider.Min, slider.Max)) + 0
        end
        function slider:Remove()
            for _, createLabel in createLabels do
                createLabel:Destroy()
            end

            lookup2[key] = nil

            slider.HolderFrame:Destroy()
            table.clear(slider)
            library:Resize()
        end
        function slider:SetValue(newValue)
            local number = tonumber(newValue)

            if not number then
                return
            end

            number = math.clamp(number, slider.Min, slider.Max)
            slider.Value = number

            slider:Display()
            label2:SafeCallback(slider.Callback, slider.Value)

            for _, changedFunc in self.ChangedFuncs do
                label2:SafeCallback(changedFunc, number)
            end
        end
        function slider:AddSlider(name, settings)
            return lookup.AddSlider(library, name, settings, slider)
        end

        parent2.InputBegan:Connect(function(input)
            if label2.IsDragging then
                return
            end
            if input.UserInputType == Enum.UserInputType.MouseButton1 and not label2:MouseIsOverOpenedFrame() then
                local mouse2 = mouse.X
                local offset = parent.Size.X.Offset
                local mouse3 = mouse2 - (parent.AbsolutePosition.X + offset)

                while(userInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)) do

                    local clamped = math.clamp(offset + (mouse.X - mouse2) + mouse3, 0, slider.MaxSize)
                    local valueFromXOffset = slider:GetValueFromXOffset(clamped)
                    local sliderValue = slider.Value

                    slider.Value = valueFromXOffset

                    slider:Display()

                    if valueFromXOffset ~= sliderValue then
                        label2:SafeCallback(slider.Callback, slider.Value)

                        for _, changedFunc in slider.ChangedFuncs do
                            label2:SafeCallback(changedFunc, valueFromXOffset)
                        end
                    end

                    renderStepped:Wait()
                end

                label2:AttemptSave()
            end
            if input.UserInputType == Enum.UserInputType.Touch and not label2:MouseIsOverOpenedFrame() then
                local inputPosition = input.Position.X
                local offset = parent.Size.X.Offset
                local inputPosition2 = inputPosition - (parent.AbsolutePosition.X + offset)
                local flag = true
                local connection

                connection = input.Changed:Connect(function()
                    if input.UserInputState == Enum.UserInputState.End then
                        flag = false
                    end
                end)

                while flag do

                    local clamped = math.clamp(offset + (input.Position.X - inputPosition) + inputPosition2, 0, slider.MaxSize)
                    local valueFromXOffset = slider:GetValueFromXOffset(clamped)
                    local sliderValue = slider.Value

                    slider.Value = valueFromXOffset

                    slider:Display()

                    if valueFromXOffset ~= sliderValue then
                        label2:SafeCallback(slider.Callback, slider.Value)

                        for _, changedFunc in slider.ChangedFuncs do
                            label2:SafeCallback(changedFunc, valueFromXOffset)
                        end
                    end

                    renderStepped:Wait()
                end

                if connection then
                    connection:Disconnect()
                end

                label2:AttemptSave()
            end
        end)

        if label2.FlagCopying then
            local addContextMenu = label2:AddContextMenu(parent2)

            addContextMenu:AddOption('Copy Flag', function()
                pcall(setclipboard, slider.Idx)
                task.wait()
                label2:Notify('Copied flag to clipboard!', 2)
                addContextMenu:Hide()
            end)
        end

        slider:Display()

        if not thirdArgument then
            table.insert(createLabels, library:AddBlank(label.BlankSize or 6))
            library:Resize()
        end

        lookup2[key] = slider
    end
end

local function setupTab(uIListLayout, label, tab, scrollingFrame, frameRef, scrollingFrame2, frame, createLabel, create, createLabelRef, key, textLabelRef, settings, frame2, frameRef2, uIStroke)

    return function()
        if label.IsMobile then
            local settings = {
                Left = tick(),
                Right = tick(),
            }

            scrollingFrame:GetPropertyChangedSignal('CanvasPosition'):Connect(function()
                label.CanDrag = false

                local now = tick()

                settings.Left = now

                task.wait(0.15)

                if settings.Left == now then
                    label.CanDrag = true
                end
            end)
            scrollingFrame2:GetPropertyChangedSignal('CanvasPosition'):Connect(function()
                label.CanDrag = false

                local now = tick()

                settings.Right = now

                task.wait(0.15)

                if settings.Right == now then
                    label.CanDrag = true
                end
            end)
        end

        for _, instance in next, {scrollingFrame, scrollingFrame2}do
            instance:WaitForChild('UIListLayout'):GetPropertyChangedSignal('AbsoluteContentSize'):Connect(function()
                instance.CanvasSize = UDim2.fromOffset(0, instance.UIListLayout.AbsoluteContentSize.Y)
            end)
        end

        function tab:Resize()
            if frameRef.value.Visible == true then
                local offsetY = 10

                for _, valueChildrenItem in next, frameRef2.value:GetChildren()do

                    if not valueChildrenItem:IsA('UIListLayout') and valueChildrenItem.Visible then
                        offsetY = offsetY + valueChildrenItem.Size.Y.Offset
                    end
                end

                frameRef.value.Size = UDim2.new(1, -10, 0, offsetY)
                offsetY = offsetY + 10
                scrollingFrame.Position = UDim2.new(0, 7, 0, 7 + offsetY)
                scrollingFrame.Size = UDim2.new(0.5, -10, 1, -14 - offsetY)
                scrollingFrame2.Position = UDim2.new(0.5, 5, 0, 7 + offsetY)
                scrollingFrame2.Size = UDim2.new(0.5, -10, 1, -14 - offsetY)
            else
                scrollingFrame.Position = UDim2.new(0, 7, 0, 7)
                scrollingFrame.Size = UDim2.new(0.5, -10, 1, -14)
                scrollingFrame2.Position = UDim2.new(0.5, 5, 0, 7)
                scrollingFrame2.Size = UDim2.new(0.5, -10, 1, -14)
            end
        end
        function tab:UpdateWarningBox(label2)
            if typeof(label2.Visible) == 'boolean' then
                frameRef.value.Visible = label2.Visible

                tab:Resize()
            end
            if typeof(label2.Title) == 'string' then
                textLabelRef.value.Text = label2.Title
            end
            if typeof(label2.Text) == 'string' then
                createLabelRef.value.Text = label2.Text

                local selected = select(2, label:GetTextBounds(label2.Text, label.Font, 14, Vector2.new(createLabelRef.value.AbsoluteSize.X, math.huge)))

                createLabelRef.value.Size = UDim2.new(1, -4, 0, selected)

                tab:Resize()
            end
        end
        function tab:ShowTab()
            label.ActiveTab = key

            for _, tab in next, settings.Tabs do
                tab:HideTab()
            end

            label.RegistryMap[frame].Properties.BackgroundColor3 = 'BackgroundColor'
            frame.BackgroundColor3 = label.MainColor
            frame2.Visible = true
            uIStroke.Color = Color3.fromRGB(0, 0, 0)
            createLabel.TextColor3 = label.FontColor
            create.Visible = true

            tab:Resize()
        end
        function tab:HideTab()
            frame.BackgroundColor3 = label.BackgroundColor
            label.RegistryMap[frame].Properties.BackgroundColor3 = 'MainColor'
            uIStroke.Color = Color3.fromRGB(25, 25, 25)
            createLabel.TextColor3 = label:GetDarkerColor(label.FontColor)
            create.Visible = false
            frame2.Visible = false
        end
        function tab:SetLayoutOrder(order)
            frame.LayoutOrder = order

            uIListLayout:ApplyLayout()
        end
        function tab:GetSides()
            return {
                Left = scrollingFrame,
                Right = scrollingFrame2,
            }
        end
        function tab:AddLeftGroupbox(name)
            return self:AddGroupbox({
                Side = 1,
                Name = name,
            })
        end
        function tab:AddRightGroupbox(name)
            return self:AddGroupbox({
                Side = 2,
                Name = name,
            })
        end
        function tab:AddLeftTabbox(name)
            return tab:AddTabbox({
                Name = name,
                Side = 1,
            })
        end
        function tab:AddRightTabbox(name)
            return tab:AddTabbox({
                Name = name,
                Side = 2,
            })
        end
        function tab:Remove()
            table.clear(tab)
            frame2:Destroy()
            frame:Destroy()

            settings.Tabs[key] = nil
        end

        frame.InputBegan:Connect(function(input)
            if label.IsDragging then
                return
            end
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                tab:ShowTab()
            end
        end)
        frameRef.value:GetPropertyChangedSignal('Visible'):Connect(function()
            tab:Resize()
        end)

        label.TotalTabs = label.TotalTabs + 1

        if label.TotalTabs == 1 then
            tab:ShowTab()
        end

        settings.Tabs[key] = tab
    end
end

local function setupTabBox(label, frame, tabContainer, create, metatable, instance, frame2, settings)

    return function()
        local tabboxes = settings.Tabboxes

        function tabContainer:Remove()
            create:Destroy()
            table.clear(tabContainer)

            tabboxes[instance.Name or ''] = nil
        end
        function tabContainer:AddTab(name, secondArgument)
            local panel = {}
            local frame3 = label:Create("Frame", {
                BackgroundColor3 = label.MainColor,
                BorderSizePixel = 1,
                BorderColor3 = Color3.fromRGB(0, 0, 0),
                Size = UDim2.new(0.5, 0, 1, 0),
                ZIndex = 6,
                Parent = frame,
            })
            local frame4 = label:Create("Frame", {
                BackgroundColor3 = label.AccentColor,
                BorderSizePixel = 0,
                Position = UDim2.new(0, 0, 0, 0),
                Size = UDim2.new(1, 0, 0, 1),
                ZIndex = 8,
                Visible = secondArgument or false,
                Parent = frame3,
            })

            label:AddToRegistry(frame4, {
                BackgroundColor3 = 'AccentColor',
            })

            local frame5 = label:Create("Frame", {
                BackgroundTransparency = 0,
                BackgroundColor3 = label.MainColor,
                BorderSizePixel = 1,
                BorderColor3 = label.OutlineColor,
                BorderMode = Enum.BorderMode.Inset,
                Size = (secondArgument and UDim2.new(1, -1, 1, 0) or UDim2.new(1, 0, 1, 0)),
                ZIndex = 7,
                Parent = frame3,
            })

            label:AddToRegistry(frame3, {
                BackgroundColor3 = 'MainColor',
            })
            label:AddToRegistry(frame5, {
                BackgroundColor3 = 'MainColor',
                BorderColor3 = "OutlineColor",
            })

            local createLabel = label:CreateLabel({
                Size = UDim2.new(1, 0, 1, 0),
                TextSize = 14,
                Text = name,
                TextXAlignment = Enum.TextXAlignment.Center,
                ZIndex = 7,
                Parent = frame3,
            })
            local frame6 = label:Create("Frame", {
                BackgroundColor3 = label.BackgroundColor,
                BorderSizePixel = 0,
                Position = UDim2.new(0, 0, 1, 0),
                Size = UDim2.new(1, 0, 0, 1),
                Visible = false,
                ZIndex = 9,
                Parent = frame3,
            })

            label:AddToRegistry(frame6, {
                BackgroundColor3 = 'BackgroundColor',
            })

            local frame7 = label:Create("Frame", {
                BackgroundTransparency = 1,
                Position = UDim2.new(0, 4, 0, 20),
                Size = UDim2.new(1, -4, 1, -20),
                ZIndex = 1,
                Visible = false,
                Parent = frame2,
            })

            label:Create('UIListLayout', {
                FillDirection = Enum.FillDirection.Vertical,
                SortOrder = Enum.SortOrder.LayoutOrder,
                Parent = frame7,
            })

            function panel:Show()
                for _, tab in next, tabContainer.Tabs do
                    tab:Hide()
                end

                frame7.Visible = true
                frame6.Visible = true
                frame5.Visible = false
                frame4.Visible = true
                frame3.BackgroundColor3 = label.BackgroundColor
                label.RegistryMap[frame3].Properties.BackgroundColor3 = 'BackgroundColor'

                panel:Resize()
            end
            function panel:Hide()
                frame7.Visible = false
                frame6.Visible = false
                frame5.Visible = true
                frame4.Visible = false
                frame3.BackgroundColor3 = label.MainColor
                label.RegistryMap[frame3].Properties.BackgroundColor3 = 'MainColor'
            end
            function panel:Resize()
                local number = 0

                for _, tab in next, tabContainer.Tabs do

                    number = number + 1
                end
                for _, frameChildrenItem in next, frame:GetChildren()do

                    if not frameChildrenItem:IsA('UIListLayout') then
                        frameChildrenItem.Size = UDim2.new(1 / number, 0, 1, 0)
                    end
                end

                if not frame7.Visible then
                    return
                end

                local number2 = 0

                for _, containerChildrenItem in next, panel.Container:GetChildren()do

                    if not containerChildrenItem:IsA('UIListLayout') and containerChildrenItem.Visible then
                        number2 = number2 + containerChildrenItem.Size.Y.Offset
                    end
                end

                create.Size = UDim2.new(1, 0, 0, 20 + number2 + 2 + 2)
            end

            frame3.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 and not label:MouseIsOverOpenedFrame() or input.UserInputType == Enum.UserInputType.Touch then
                    panel:Show()
                    panel:Resize()
                end
            end)

            panel.Container = frame7
            tabContainer.Tabs[name] = panel

            setmetatable(panel, metatable)
            panel:AddBlank(3)
            panel:Resize()

            if #frame:GetChildren() == 2 then
                panel:Show()
            end

            return panel
        end

        settings.Tabboxes[instance.Name or ''] = tabContainer
    end
end

local function setupTextLabel(text2, metatable, label, createLabel, library, sixthArgument)

    return function()
        function library:SetText(text)
            createLabel.Text = text

            if sixthArgument then
                local selected = select(2, label:GetTextBounds(text, label.Font, 14, Vector2.new(createLabel.AbsoluteSize.X, math.huge)))

                createLabel.Size = UDim2.new(1, -4, 0, selected)
            end

            text2:Resize()
        end

        local list = {}

        function library:Remove()
            for _, item in list do
                item:Destroy()
            end

            createLabel:Destroy()
            table.clear(library)
            text2:Resize()
        end

        if not sixthArgument then
            setmetatable(library, metatable)
        end

        table.insert(list, text2:AddBlank(5))
        text2:Resize()
    end
end

