local function makeHitEffectSpawner(instance, colorRef, hit_effects_weldValueRef)

    return function(part, _, _, _)
        local instanceClone = instance:Clone()

        for _, descendant in instanceClone:GetDescendants()do

            if descendant.Name == 'MainEmitter' then
                descendant.Color = colorRef.value
            end
            if descendant.ClassName == 'ParticleEmitter' then
                descendant:Emit(5)
            end
        end

        instanceClone.Parent = workspace
        instanceClone.Position = part.Position

        if hit_effects_weldValueRef.value then
            instanceClone.Anchored = false

            local weldConstraint = Instance.new('WeldConstraint', instanceClone)

            weldConstraint.Part0 = part
            weldConstraint.Part1 = instanceClone
        end

        task.delay(1, instanceClone.Destroy, instanceClone)
    end
end

